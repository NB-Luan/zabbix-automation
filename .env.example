# ==============================================================================
# .env.example - Zabbix Automation Environment Configuration Template
# Copy this file to .env and adjust values if your VM setup differs from default.
# ==============================================================================

# Target VM2: Web Server (Nginx & Zabbix Agent 2)
WEB_SERVER_IP=192.168.56.21
WEB_SERVER_USER=linux-moniter
WEB_SERVER_PORT=22
WEB_SERVER_STUB_PORT=8080

# Target VM1: Zabbix Server 7.0 LTS
ZABBIX_SERVER_IP=192.168.56.10
ZABBIX_API_URL=http://192.168.56.10/zabbix/api_jsonrpc.php
ZABBIX_API_USER=Admin
ZABBIX_API_PASS=zabbix
TARGET_HOST_NAME=web-server

# Optional: Path to private SSH key (leave blank to use default ~/.ssh/id_rsa or ~/.ssh/id_ed25519)
SSH_KEY_FILE=
